{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triplecode.ru/schemas/release-manifest.json",
  "type": "object",
  "required": ["version", "channel", "publishedAt", "artifacts"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "enum": ["stable", "preview"] },
    "publishedAt": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["os", "arch", "name", "url", "sha512"],
        "properties": {
          "os": { "type": "string", "enum": ["darwin", "win32", "linux"] },
          "arch": { "type": "string", "enum": ["arm64", "x64"] },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "sha512": { "type": "string", "minLength": 128, "maxLength": 128 }
        }
      }
    }
  }
}
